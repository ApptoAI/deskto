{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ELECTRON_RENDERER_URL",
    "PATH",
    "DESKTO_FORCE_ONBOARDING",
    "DESKTO_SIMULATE_NO_AGENTS"
  ],
  "globalPassThroughEnv": [
    "SHELL",
    "AZURE_TENANT_ID",
    "AZURE_CLIENT_ID",
    "AZURE_CLIENT_SECRET",
    "WINDOWS_SIGNING_ENDPOINT",
    "WINDOWS_SIGNING_ACCOUNT_NAME",
    "WINDOWS_SIGNING_CERTIFICATE_PROFILE_NAME",
    "WINDOWS_SIGNING_PUBLISHER_NAME"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
