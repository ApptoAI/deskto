{
  "name": "@openappto/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.ts\"",
    "lint": "eslint .",
    "package": "pnpm build && electron-builder --config electron-builder.config.ts",
    "package:dir": "pnpm build && electron-builder --dir --config electron-builder.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.231",
    "@openappto/client": "workspace:*",
    "@openappto/protocol": "workspace:*",
    "@openappto/runtime": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.31.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9",
    "typescript": "^5",
    "vite": "^7.3.1"
  }
}
