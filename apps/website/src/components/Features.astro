---
import ClaudeLogo from "../assets/claude.svg"
import OpenAILogo from "../assets/openai.svg"

// One card per thing the person actually touches in the app, in the order
// they meet them: workspace, project, inbox, delegation, approvals, account.
const features = [
  {
    title: "A workspace for each part of your work",
    body: "Sales and ops each get their own workspace, with their own projects and skill packs. Attach a pack once and every project inside has the same playbooks.",
  },
  {
    title: "Projects are folders on your disk",
    body: "Open a folder you already have or let Deskto create one. Agents work inside it and nowhere else. Results land as files you can open.",
  },
  {
    title: "An inbox, not a chat list",
    body: "Tasks run in the background and come back as things to review. Pin them, snooze them, mark them done. A failed task stays until you deal with it; a quiet one closes itself.",
  },
  {
    title: "One agent can hire more",
    body: "Give an agent a big job and it can split it into child tasks that run side by side, each on whichever agent fits. Every child is a real task with its own conversation and approvals, and it can search what you have done before.",
  },
  {
    title: "Approvals come to you",
    body: "By default an agent stops before a command that could do damage. The request waits in your inbox until you answer, and a task waiting on you is never hidden.",
  },
  {
    title: "Your subscription, not another bill",
    body: "Claude Code and Codex run on your machine, on the plans you already pay for. Sign in to each once. Every task picks its agent and model.",
    logos: true,
  },
]
---

<section class="features ruled">
  <div class="section-head features-head" data-reveal>
    <p class="eyebrow">what deskto does</p>
    <h2 class="display features-title">What you delegate<br />comes back as files.</h2>
  </div>

  <ul class="hairline-grid features-grid">
    {
      features.map((feature, index) => (
        <li
          class="feature"
          data-reveal
          style={`--reveal-delay: ${(index % 3) * 60}ms`}
        >
          <span class="feature-index">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-body">{feature.body}</p>
          {
            feature.logos ? (
              <span class="feature-logos">
                <ClaudeLogo
                  class="feature-logo feature-logo--claude"
                  aria-label="Claude Code"
                  role="img"
                />
                <OpenAILogo
                  class="feature-logo"
                  aria-label="Codex"
                  role="img"
                />
              </span>
            ) : null
          }
        </li>
      ))
    }
  </ul>
</section>

<style>
  .features {
    padding-top: clamp(64px, 9vw, 112px);
  }

  .features-head {
    gap: 16px;
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .features-title {
    font-size: clamp(28px, 3.6vw, 40px);
  }

  .features-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .feature {
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted-ink);
  }

  .feature-title {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.014em;
    color: var(--ink);
  }

  .feature-body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted-ink);
  }

  .feature-logos {
    display: flex;
    gap: 14px;
    margin-top: auto;
    padding-top: 4px;
    color: var(--ink);
  }
  .feature-logo {
    width: 18px;
    height: 18px;
  }
  .feature-logo--claude {
    color: #d97757;
  }

  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
