---
import Mark from "../assets/deskto-mark.svg"
import DownloadButtons from "./DownloadButtons.astro"
---

<section class="cta ruled dots">
  <div class="section-head cta-inner" data-reveal>
    <Mark height={28} class="cta-mark" />
    <h2 class="display cta-title">Put it on your desk.</h2>
    <DownloadButtons secondary="platforms" />
    <p class="fine">open source · your own subscription · runs on your machine</p>
  </div>
</section>

<style>
  .cta-inner {
    gap: 20px;
    padding-block: clamp(72px, 10vw, 128px);
  }

  .cta-mark {
    color: var(--ink);
  }

  .cta-title {
    font-size: clamp(28px, 3.6vw, 40px);
  }

  .cta-inner :global(.actions) {
    padding-top: 4px;
  }
</style>
